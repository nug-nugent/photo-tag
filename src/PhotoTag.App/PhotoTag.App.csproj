<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PhotoTag</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Release builds pass -p:Version=x.y.z from the git tag. -->
    <Version>0.0.0-dev</Version>
    <Product>PhotoTag</Product>
    <Copyright>Copyright © 2026 David Huggett</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Release packages leave out the parts of .NET and the libraries PhotoTag never calls. Trim warnings
         are errors, and every package's self-check runs the trimmed app. -->
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <!-- SkiaSharp and HarfBuzzSharp ship ~100 MB of Windows debug symbols (libSkiaSharp.pdb) beside their DLLs. -->
  <Target Name="DropNativeDebugSymbols" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon-256.png" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\OFL.txt" Link="Archivo-OFL.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoTag.Core\PhotoTag.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhotoTag.App.Tests" />
  </ItemGroup>
</Project>
