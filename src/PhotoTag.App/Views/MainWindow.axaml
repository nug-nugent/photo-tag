<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoTag.App.ViewModels"
        xmlns:layout="using:Avalonia.Layout"
        x:Class="PhotoTag.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PhotoTag" Width="1280" Height="720" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.tile">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.tile:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Border.tile.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
        </Style>
        <Style Selector="Border.chip.partial">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
        <Style Selector="Button.chipRemove">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.star">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="Goldenrod" />
        </Style>
        <Style Selector="Border.notice">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="OrangeRed" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Open folder…" Click="OpenFolder_Click" />
                <TextBlock Text="{Binding RootPath}" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding Operations.IsBusy}">
                    <ProgressBar Width="160" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                 Value="{Binding Operations.ProgressPercent}" />
                    <Button x:Name="CancelBulkButton" Content="Cancel" Padding="10,2" FontSize="12"
                            Command="{Binding Operations.CancelCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" FontSize="12" Margin="12,0"
                           VerticalAlignment="Center" />
                <Panel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding !Operations.IsBusy}" />
                    <TextBlock Text="{Binding Operations.ProgressText}" FontSize="12" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Operations.IsBusy}" />
                </Panel>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="260,Auto,*,Auto,340">
            <!-- Folder tree -->
            <TreeView Grid.Column="0" ItemsSource="{Binding RootFolders}" SelectedItem="{Binding SelectedFolder}">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:FolderNodeViewModel">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />

            <!-- Thumbnail grid: ItemsRepeater only creates tiles for what's on screen.
                 Focusable so arrow keys, Shift+arrows, Ctrl/⌘+A and Esc work once a tile is clicked. -->
            <ScrollViewer x:Name="GridScroller" Grid.Column="2" Focusable="True" KeyDown="Grid_KeyDown">
                <ItemsRepeater x:Name="PhotoGrid" Margin="8" ItemsSource="{Binding Photos}"
                               ElementPrepared="PhotoGrid_ElementPrepared"
                               ElementClearing="PhotoGrid_ElementClearing">
                    <ItemsRepeater.Layout>
                        <layout:UniformGridLayout MinItemWidth="150" MinItemHeight="176"
                                                  MinColumnSpacing="6" MinRowSpacing="6"
                                                  ItemsStretch="Uniform" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhotoItemViewModel">
                            <Border Classes="tile" Classes.selected="{Binding IsSelected}"
                                    PointerPressed="Tile_PointerPressed"
                                    ToolTip.Tip="{Binding FileName}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding FileName}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    <Panel>
                                        <TextBlock Text="Can't read this file" IsVisible="{Binding LoadFailed}"
                                                   FontSize="11" Opacity="0.6"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    </Panel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <GridSplitter Grid.Column="3" Width="4" ResizeDirection="Columns" />

            <!-- Details for the selected photo -->
            <ScrollViewer Grid.Column="4">
                <Panel>
                    <TextBlock Text="Select a photo to see its details." Opacity="0.6" Margin="16"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNull}}" />
                    <ContentControl Content="{Binding Details}">
                        <ContentControl.DataTemplates>
                            <DataTemplate x:DataType="vm:PhotoDetailsViewModel">
                                <StackPanel Margin="12" Spacing="12">
                                    <!-- Thumbnail shows instantly; the sharper preview replaces it when ready. -->
                                    <Panel MaxHeight="360">
                                        <Image Source="{Binding Photo.Thumbnail}" Stretch="Uniform" />
                                        <Image Source="{Binding Preview}" Stretch="Uniform" />
                                    </Panel>

                                    <StackPanel Spacing="2">
                                        <SelectableTextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <SelectableTextBlock Text="{Binding Folder}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Error}" Foreground="OrangeRed" TextWrapping="Wrap"
                                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                    <Border Classes="notice" IsVisible="{Binding ExifToolMissing}">
                                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                                   Text="Editing tags needs ExifTool (exiftool.org). Install it, then restart PhotoTag." />
                                    </Border>

                                    <!-- Tags: chips with a remove button, plus a box to add more (Enter, or comma-separated). -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="label" Text="Tags" />
                                        <ItemsControl ItemsSource="{Binding Keywords}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Classes="chip">
                                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                                            <Button Classes="chipRemove" Content="✕"
                                                                    ToolTip.Tip="Remove tag"
                                                                    IsVisible="{Binding $parent[ItemsControl].((vm:PhotoDetailsViewModel)DataContext).CanEdit}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:PhotoDetailsViewModel)DataContext).RemoveKeywordCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <AutoCompleteBox x:Name="NewTagBox" PlaceholderText="Add a tag…"
                                                         IsEnabled="{Binding CanEdit}"
                                                         Text="{Binding NewKeyword, Mode=TwoWay}"
                                                         ItemsSource="{Binding KeywordSuggestions}"
                                                         FilterMode="ContainsOrdinal" MinimumPrefixLength="1">
                                            <AutoCompleteBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding AddKeywordCommand}" />
                                            </AutoCompleteBox.KeyBindings>
                                        </AutoCompleteBox>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="label" Text="Rating" />
                                        <ItemsControl ItemsSource="{Binding Stars}" IsEnabled="{Binding CanEdit}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StarViewModel">
                                                    <Button Classes="star" Content="{Binding Glyph}"
                                                            ToolTip.Tip="Click again to clear"
                                                            Command="{Binding $parent[ItemsControl].((vm:PhotoDetailsViewModel)DataContext).SetRatingCommand}"
                                                            CommandParameter="{Binding Value}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="label" Text="Title" />
                                        <TextBox x:Name="TitleBox" IsEnabled="{Binding CanEdit}" PlaceholderText="Add a title"
                                                 Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="label" Text="Description" />
                                        <TextBox x:Name="DescriptionBox" IsEnabled="{Binding CanEdit}" PlaceholderText="Add a description"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLines="8"
                                                 Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding SaveStatus}" FontSize="12" TextWrapping="Wrap"
                                               Classes.error="{Binding SaveFailed}" Opacity="0.7"
                                               IsVisible="{Binding SaveStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                    <StackPanel IsVisible="{Binding DateTaken, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Classes="label" Text="Taken" />
                                        <TextBlock Text="{Binding DateTaken}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding Camera, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Classes="label" Text="Camera" />
                                        <TextBlock Text="{Binding Camera}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Lens}" TextWrapping="Wrap" Opacity="0.8"
                                                   IsVisible="{Binding Lens, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <TextBlock Text="{Binding Exposure}" TextWrapping="Wrap" Opacity="0.8"
                                                   IsVisible="{Binding Exposure, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding Dimensions, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Classes="label" Text="File" />
                                        <TextBlock Text="{Binding Dimensions}" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding Location, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Classes="label" Text="Location" />
                                        <SelectableTextBlock Text="{Binding Location}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate x:DataType="vm:BulkDetailsViewModel">
                                <StackPanel Margin="12" Spacing="12">
                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="{Binding LoadingText}" Opacity="0.7" TextWrapping="Wrap"
                                               IsVisible="{Binding LoadingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <Border Classes="notice" IsVisible="{Binding ExifToolMissing}">
                                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                                   Text="Editing tags needs ExifTool (exiftool.org). Install it, then restart PhotoTag." />
                                    </Border>

                                    <StackPanel Spacing="4" IsVisible="{Binding IsLoaded}">
                                        <TextBlock Classes="label" Text="Tags" />
                                        <TextBlock Text="Tags on only some of these photos show a count. Use + to add one to all of them, ✕ to remove it from all."
                                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Keywords}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BulkKeywordViewModel">
                                                    <Border Classes="chip" Classes.partial="{Binding !IsOnAll}" ToolTip.Tip="{Binding ToolTip}">
                                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                                            <TextBlock Text="{Binding Keyword}" FontSize="12" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding CountText}" FontSize="11" Opacity="0.7" Margin="4,0,0,0"
                                                                       VerticalAlignment="Center" IsVisible="{Binding !IsOnAll}" />
                                                            <Button Classes="chipRemove chipAddAll" Content="+"
                                                                    ToolTip.Tip="Add to all selected photos"
                                                                    IsVisible="{Binding !IsOnAll}"
                                                                    IsEnabled="{Binding $parent[ItemsControl].((vm:BulkDetailsViewModel)DataContext).CanEdit}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:BulkDetailsViewModel)DataContext).ApplyToAllCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Classes="chipRemove" Content="✕"
                                                                    ToolTip.Tip="Remove from all selected photos"
                                                                    IsEnabled="{Binding $parent[ItemsControl].((vm:BulkDetailsViewModel)DataContext).CanEdit}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:BulkDetailsViewModel)DataContext).RemoveKeywordCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <AutoCompleteBox x:Name="BulkTagBox" PlaceholderText="Add a tag to all of them…"
                                                         IsEnabled="{Binding CanEdit}"
                                                         Text="{Binding NewKeyword, Mode=TwoWay}"
                                                         ItemsSource="{Binding KeywordSuggestions}"
                                                         FilterMode="ContainsOrdinal" MinimumPrefixLength="1">
                                            <AutoCompleteBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding AddKeywordCommand}" />
                                            </AutoCompleteBox.KeyBindings>
                                        </AutoCompleteBox>
                                    </StackPanel>

                                    <StackPanel Spacing="4" IsVisible="{Binding IsLoaded}">
                                        <TextBlock Classes="label" Text="Rating" />
                                        <ItemsControl ItemsSource="{Binding Stars}" IsEnabled="{Binding CanEdit}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StarViewModel">
                                                    <Button Classes="star" Content="{Binding Glyph}"
                                                            Command="{Binding $parent[ItemsControl].((vm:BulkDetailsViewModel)DataContext).SetRatingCommand}"
                                                            CommandParameter="{Binding Value}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding RatingNote}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                                   IsVisible="{Binding RatingNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>

                                    <TextBlock Text="Titles and descriptions are edited one photo at a time." FontSize="11"
                                               Opacity="0.6" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </Panel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
