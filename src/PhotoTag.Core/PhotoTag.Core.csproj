<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The app is published trimmed; this flags trim-unsafe code at build time. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MetadataExtractor" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PhotoTag.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- GeoNames place data for "Fill from GPS", built by build/MakePlaces.cs. -->
    <EmbeddedResource Include="Places\places.bin" LogicalName="PhotoTag.Core.Places.places.bin" />
  </ItemGroup>
</Project>
